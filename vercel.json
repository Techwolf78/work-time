{
  "headers": [
    {
      "source": "/downloads/(.*)\\.exe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.microsoft.portable-executable"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"GA-Work-Time.exe\""
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/(.*)\\.zip",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"GA-Work-Time.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/install.ps1",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/downloads/install.ps1",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/:path*",
      "destination": "/downloads/:path*"
    },
    {
      "source": "/install.ps1",
      "destination": "/install.ps1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
